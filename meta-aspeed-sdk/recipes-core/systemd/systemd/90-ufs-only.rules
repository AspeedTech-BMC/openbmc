# Clean symlinks created for non-UFS devices (e.g., mmc)
KERNEL=="mmcblk[0-9]p[0-9]", SYMLINK-="disk/by-partlabel/%E{ID_PART_ENTRY_NAME}"

# Only process sda/sdX devices (UFS)
KERNEL!="sd*[0-9]", GOTO="ufs_only_end"

# Create by-partlabel link (GPT only)
ENV{ID_PART_ENTRY_SCHEME}=="gpt", ENV{ID_PART_ENTRY_NAME}=="?*", SYMLINK+="disk/by-partlabel/$env{ID_PART_ENTRY_NAME}"

LABEL="ufs_only_end"
