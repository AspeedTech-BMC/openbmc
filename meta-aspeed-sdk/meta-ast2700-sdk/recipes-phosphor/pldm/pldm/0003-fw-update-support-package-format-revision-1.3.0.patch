 using namespace pldm::fw_update;
 
+/** @brief Append the PackageHeaderChecksum of the package header
+ *
+ *  Computing it here rather than hardcoding it keeps the test packages
+ *  maintainable, patching a header field does not require recomputing a
+ *  constant by hand.
+ */
+void appendChecksum(std::vector<uint8_t>& fwPkgHdr)
+{
+    const uint32_t check = pldm_edac_crc32(fwPkgHdr.data(), fwPkgHdr.size());
+    const auto checksum =
+        std::bit_cast<std::array<uint8_t, sizeof(check)>>(check);
+    fwPkgHdr.insert(fwPkgHdr.end(), checksum.begin(), checksum.end());
+}
