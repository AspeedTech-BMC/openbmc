+    configFile.close();
+
+    ConditionConfigManager manager(testConfigPath);
+    EXPECT_EQ(manager.preCondition("BIOS"), "");
+    EXPECT_EQ(manager.postCondition("BIOS"), "bios-post.service");
+}
