From 46e8b8f2594a5596e6f9e22a83a2910d39793991 Mon Sep 17 00:00:00 2001
From: Vince Chang <vince_chang@aspeedtech.com>
Date: Wed, 28 May 2025 15:55:16 -0600
Subject: [PATCH] Add multi node support

Add node option to customize snoop object and dbus.

Tested:

```
root@ast2700-default:~# /usr/bin/snoopd -b 1 -d /dev/aspeed-lpc-snoop1 -n 1 &
root@ast2700-default:~# busctl tree xyz.openbmc_project.State.Boot.Raw1
`- /xyz
  `- /xyz/openbmc_project
    `- /xyz/openbmc_project/state
      `- /xyz/openbmc_project/state/boot
        `- /xyz/openbmc_project/state/boot/raw1
root@ast2700-default:~# snooper 1
node1_recv: 0x7e
node1_recv: 0xb0
node1_recv: 0x7e
node1_recv: 0xb1
node1_recv: 0xaf
```

Upstream-Status: Submitted [https://gerrit.openbmc.org/c/openbmc/phosphor-host-postd/+/80597]

Change-Id: I926ea01a542ab527f438a99875aeab75ef4f89d8
Signed-off-by: Vince Chang <vince_chang@aspeedtech.com>
