     std::unique_ptr<lpcsnoop::SnoopListen> snoop =
-        std::make_unique<lpcsnoop::SnoopListen>(ListenBus, DisplayDbusValue, f);
+        std::make_unique<lpcsnoop::SnoopListen>(ListenBus, DisplayDbusValue,
