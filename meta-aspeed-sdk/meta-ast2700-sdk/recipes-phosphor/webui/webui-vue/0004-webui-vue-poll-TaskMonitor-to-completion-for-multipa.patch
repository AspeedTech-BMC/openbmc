 src/locales/en-US.json                        |  1 +
 src/store/modules/Operations/FirmwareStore.js | 31 ++++++++++++-
 .../Firmware/FirmwareFormUpdate.vue           | 44 +++++++++++++------
 3 files changed, 61 insertions(+), 15 deletions(-)

