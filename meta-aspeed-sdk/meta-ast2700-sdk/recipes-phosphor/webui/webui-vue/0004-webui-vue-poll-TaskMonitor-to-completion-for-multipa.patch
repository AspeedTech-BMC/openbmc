       if (forceUpdate) params.ForceUpdate = true;
       params['@Redfish.OperationApplyTime'] = applyTime;
       formData.append('UpdateParameters', JSON.stringify(params));
-      return await api
+
+      const uploadResponse = await api
         .post(state.multipartHttpPushUri, formData, {
           headers: { 'Content-Type': 'multipart/form-data' },
         })
@@ -166,6 +167,34 @@ const FirmwareStore = {
             i18n.global.t('pageFirmware.toast.errorUpdateFirmware'),
           );
         });
+
+      const taskMonitorUrl = uploadResponse.headers?.location;
+      if (!taskMonitorUrl) {
+        return uploadResponse;
+      }
+
+      // Poll TaskMonitor until task completes (202 = running, other = done).
+      // Disable cache to always get a fresh response from the server.
+      const maxAttempts = 120; // 10 minutes at 5s intervals
+      for (let attempt = 0; attempt < maxAttempts; attempt++) {
+        await new Promise((resolve) => setTimeout(resolve, 5000));
+        const taskResponse = await api
+          .get(taskMonitorUrl, { cache: false })
+          .catch((error) => {
+            if (error.response?.status === 500) {
+              throw new Error(
+                i18n.global.t('pageFirmware.toast.errorFirmwareUpdateFailed'),
+              );
+            }
+            throw new Error(
+              i18n.global.t('pageFirmware.toast.errorUpdateFirmware'),
+            );
+          });
+        if (taskResponse.status !== 202) {
+          return taskResponse;
+        }
+      }
+      throw new Error(i18n.global.t('pageFirmware.toast.errorUpdateFirmware'));
     },
     async switchBmcFirmwareAndReboot({ getters }) {
       const backupLocation = getters.backupBmcFirmware.location;
