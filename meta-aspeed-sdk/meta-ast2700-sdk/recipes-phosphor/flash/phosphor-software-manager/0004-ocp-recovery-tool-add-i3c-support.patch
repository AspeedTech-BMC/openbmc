     return success;
 }
 
+/* Finds every /sys/bus/i3c/devices/<bus>-* entry exposing an ocp_recovery
+ * sysfs group, for --i3c mode when the caller gave -b/--bus but neither
+ * -p/--pid nor -g/--i3c-group. */
+std::vector<std::string> findI3cGroups(uint16_t bus)
+{
+    namespace fs = std::filesystem;
+
+    const std::string prefix = std::format("{}-", bus);
+    std::vector<std::string> groups;
+    std::error_code ec;
+
+    /* Constructing with the error_code overload yields the end iterator
+     * (i.e. zero iterations) instead of throwing when the path doesn't
+     * exist, which is exactly "no matches" here. */
+    for (const auto& entry : fs::directory_iterator("/sys/bus/i3c/devices",
+                                                     ec))
+    {
+        if (!entry.path().filename().string().starts_with(prefix))
+        {
+            continue;
+        }
+
+        const fs::path group = entry.path() / "ocp_recovery";
+        if (fs::exists(group / "cmd_resp", ec))
+        {
+            groups.push_back(group.string());
+        }
+    }
+
+    return groups;
+}
+
 } // namespace
 
 int main(int argc, char** argv)
 {
