+std::expected<void, std::error_code> Target::indirectFifoCtrl(
+    uint8_t window, bool reset, uint64_t imageSize)
+{
+    /* Wire field is in 4-byte units; round up so the device reserves
+     * enough space for a size that isn't itself 4-byte aligned. */
+    const auto sizeUnits =
+        static_cast<uint32_t>((imageSize + 3) / 4);
+    const std::array<uint8_t, 6> payload = {
+        window,
+        static_cast<uint8_t>(reset ? 0x01 : 0x00),
+        static_cast<uint8_t>(sizeUnits & 0xFF),
+        static_cast<uint8_t>((sizeUnits >> 8) & 0xFF),
+        static_cast<uint8_t>((sizeUnits >> 16) & 0xFF),
+        static_cast<uint8_t>((sizeUnits >> 24) & 0xFF),
+    };
+
+    return command(Cmd::indirectFifoCtrl, payload);
+}
+
+std::expected<IndirectFifoStatusInfo, std::error_code>
+    Target::indirectFifoStatus()
+{
+    std::array<uint8_t, respLenIndirectFifoStatus> resp{};
+
+    const auto count = commandRead(Cmd::indirectFifoStatus, resp,
+                                   respLenIndirectFifoStatus - 1);
+    if (!count)
+    {
+        return std::unexpected(count.error());
+    }
+
+    return IndirectFifoStatusInfo{
+        .empty = (resp[1] & 0x01) != 0,
+        .full = (resp[1] & 0x02) != 0,
+        .type = FifoRegionType{resp[2]},
+        .writeIndexUnits = getLe32(std::span(resp).subspan(5)),
+        .readIndexUnits = getLe32(std::span(resp).subspan(9)),
+        .fifoSizeUnits = getLe32(std::span(resp).subspan(13)),
+        .maxTransferUnits = getLe32(std::span(resp).subspan(17)),
+    };
+}
+
+std::expected<void, std::error_code> Target::writeIndirectFifoData(
+    std::span<const uint8_t> data)
+{
+    if (data.empty() || data.size() > chunkSize || chunkSize > chunkSizeMax)
+    {
+        return failure(std::errc::invalid_argument);
+    }
+
+    return command(Cmd::indirectFifoData, data);
+}
+
 /* Blocking convenience layer */
 
 std::expected<void, std::error_code> Target::waitWriteAck()
@@ -338,21 +392,102 @@ std::expected<void, std::error_code> Target::writeImage(
     return {};
 }
 
-std::expected<void, std::error_code> Target::recover(
+std::expected<void, std::error_code> Target::waitFifoSpace(
+    size_t neededBytes)
+{
+    for (unsigned int poll = 0; poll < ackPollRetries; poll++)
+    {
+        const auto status = indirectFifoStatus();
+        if (!status)
+        {
+            return std::unexpected(status.error());
+        }
+        if (uint64_t{status->spaceRemainingUnits()} * 4 >= neededBytes)
+        {
+            return {};
+        }
+        std::this_thread::sleep_for(ackPollInterval);
+    }
+
+    return failure(std::errc::timed_out);
+}
+
+std::expected<void, std::error_code> Target::writeImageFifo(
     std::span<const uint8_t> image, const ProgressFn& progress)
 {
-    if (image.empty())
+    if (image.empty() || chunkSize == 0 || chunkSize > chunkSizeMax)
     {
         return failure(std::errc::invalid_argument);
     }
 
-    /* Tolerant: many devices do not implement PROT_CAP; only fail when
-     * the device positively reports FIFO-only support. */
-    if (const auto cap = getProtCap(); cap && cap->fifoOnly())
+    /* Clamp to the device-advertised max INDIRECT_FIFO_DATA payload, when
+     * it reports one; a fixed chunk size for the whole transfer keeps
+     * this simple and matches "transfers ... with size less than or
+     * equal to the max transfer size" from the spec. */
+    size_t chunk = chunkSize;
+    if (const auto status = indirectFifoStatus(); status)
     {
-        return failure(std::errc::not_supported);
+        const uint64_t maxTransfer = status->maxTransferBytes();
+        if (maxTransfer > 0 && maxTransfer < chunk)
+        {
+            chunk = static_cast<size_t>(maxTransfer);
+        }
     }
 
+    size_t offset = 0;
+    while (offset < image.size())
+    {
+        const auto piece =
+            image.subspan(offset, std::min(chunk, image.size() - offset));
+
+        std::expected<void, std::error_code> result =
+            failure(std::errc::timed_out);
+
+        for (unsigned int attempt = 0; attempt < chunkWriteRetries; attempt++)
+        {
+            if (auto space = waitFifoSpace(piece.size()); !space)
+            {
+                result = space;
+                continue;
+            }
+
+            result = writeIndirectFifoData(piece);
+            if (result)
+            {
+                break;
+            }
+        }
+        if (!result)
+        {
+            return result;
+        }
+
+        offset += piece.size();
+
+        if (progress)
+        {
+            progress(offset, image.size());
+        }
+    }
+
+    return {};
+}
+
+std::expected<void, std::error_code> Target::recover(
+    std::span<const uint8_t> image, const ProgressFn& progress)
+{
+    if (image.empty())
+    {
+        return failure(std::errc::invalid_argument);
+    }
+
+    /* Tolerant: many devices do not implement PROT_CAP. When it is
+     * implemented and the device advertises only the v1.1 FIFO indirect
+     * mechanism, stage the image through INDIRECT_FIFO_CTRL/DATA instead
+     * of the memory-window INDIRECT_CTRL/DATA pair. */
+    const auto cap = getProtCap();
+    const bool useFifo = cap && cap->fifoOnly();
+
     auto status = getDeviceStatus();
     if (!status)
     {
@@ -389,14 +524,27 @@ std::expected<void, std::error_code> Target::recover(
         return ctrl;
     }
 
-    if (auto ctrl = indirectCtrl(cms, 0); !ctrl)
+    if (useFifo)
     {
