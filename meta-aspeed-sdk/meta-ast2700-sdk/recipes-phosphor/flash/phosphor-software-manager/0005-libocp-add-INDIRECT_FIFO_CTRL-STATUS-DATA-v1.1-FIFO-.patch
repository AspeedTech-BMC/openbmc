@@ -209,6 +218,53 @@ struct IndirectStatusInfo
     }
 };
 
+/* INDIRECT_FIFO_STATUS region type (byte 1) */
+enum class FifoRegionType : uint8_t
+{
+    code = 0b000,        /* code space for recovery, write only */
+    log = 0b001,          /* debug log format, read only */
+    vendorWrite = 0b100,
+    vendorRead = 0b101,
+    unsupported = 0b111, /* CMS index does not support this access type */
+};
+
+struct IndirectFifoStatusInfo
+{
+    bool empty;
+    bool full;
+    FifoRegionType type;
+    uint32_t writeIndexUnits; /* offset, 4-byte units, advanced by the RA */
+    uint32_t readIndexUnits;  /* offset, 4-byte units, advanced by the device */
+    uint32_t fifoSizeUnits;   /* FIFO window size, 4-byte units */
+    uint32_t maxTransferUnits; /* max INDIRECT_FIFO_DATA payload, 4-byte units */
+
+    [[nodiscard]] uint64_t fifoSizeBytes() const
+    {
+        return uint64_t{fifoSizeUnits} * 4;
+    }
+
+    [[nodiscard]] uint64_t maxTransferBytes() const
+    {
+        return uint64_t{maxTransferUnits} * 4;
+    }
+
+    /* FIFO space remaining, in 4-byte units, per the spec formula:
+     * (Read Index - (Write Index + 1) + FIFO Size) % FIFO Size.
+     * Deliberately done in native uint32_t (matching the wire field
+     * width) rather than a wider type: the indices are free-running
+     * counters that wrap at 2^32, and unsigned wraparound is what makes
+     * this formula give the right cyclic distance even after that. */
+    [[nodiscard]] uint32_t spaceRemainingUnits() const
+    {
+        if (fifoSizeUnits == 0)
+        {
+            return 0;
+        }
+        return (readIndexUnits - (writeIndexUnits + 1) + fifoSizeUnits) %
+               fifoSizeUnits;
+    }
+};
+
 /* One bus transaction: write wbuf; a non-empty rbuf requests a
  * repeated-start read into it. Returns a default-constructed (falsy)
  * error_code on success. Implementations must accept writes up to one
@@ -350,6 +406,24 @@ class Target
     [[nodiscard]] std::expected<size_t, std::error_code> readIndirectData(
         std::span<uint8_t> buf);
 
+    /* INDIRECT_FIFO_CTRL: select a FIFO-model CMS window. When reset is
+     * true the device's Write/Read indices are reset to their initial
+     * value (use this at the start of a fresh image push). imageSize is
+     * in bytes; the wire field is 4-byte units, so this rounds up. */
+    [[nodiscard]] std::expected<void, std::error_code> indirectFifoCtrl(
