+     * doing their own chunking should check indirectFifoStatus() first,
+     * or use writeImageFifo() below. */
+    [[nodiscard]] std::expected<void, std::error_code> writeIndirectFifoData(
+        std::span<const uint8_t> data);
+
     /* Blocking convenience layer (sleeps with std::this_thread; for tests
      * and standalone tooling, NOT for use inside an event loop) */
 
