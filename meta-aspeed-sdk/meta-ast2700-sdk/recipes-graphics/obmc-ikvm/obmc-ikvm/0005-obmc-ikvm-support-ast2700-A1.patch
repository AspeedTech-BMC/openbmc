From 84d61ae4ece5d8fa83f666e8f79a37160406c6ef Mon Sep 17 00:00:00 2001
From: Vince Chang <vince_chang@aspeedtech.com>
Date: Wed, 31 Dec 2025 11:20:11 -0600
Subject: [PATCH 6/6] obmc-ikvm: support ast2700 A1

For AST2700-A1:
Node0 KVM and VM use 0x12060000 (PCIe-EHCI-vHUB + PCIe-XHCI-PHY)
Node1 KVM and VM use 0x12021000 (PCIe-XHCI-vHUB)

Upstream-Status: Pending
Signed-off-by: Vince Chang <vince_chang@aspeedtech.com>
---
 ikvm_input.hpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/ikvm_input.hpp b/ikvm_input.hpp
index d34bd9a..3bbc302 100644
--- a/ikvm_input.hpp
+++ b/ikvm_input.hpp
@@ -87,7 +87,7 @@ class Input
     static constexpr const char* USB_VHUB_PATH =
         "/sys/bus/platform/devices/12060000.usb-vhub";
     static constexpr const char* USB_VHUB_PATH_1 =
-        "/sys/bus/platform/devices/12062000.usb-vhub";
+        "/sys/bus/platform/devices/12021000.usb-vhub";
     /* @brief Retry limit for writing an HID report */
     static constexpr int HID_REPORT_RETRY_MAX = 5;
     /*
