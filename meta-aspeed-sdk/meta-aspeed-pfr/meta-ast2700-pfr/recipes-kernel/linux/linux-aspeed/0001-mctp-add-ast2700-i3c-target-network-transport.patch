@@ -3728,12 +3728,12 @@ i3c_target_register_new_i3c_dev(struct i3c_master_controller *master, struct i3c
 
 	desc = kzalloc(sizeof(*desc), GFP_KERNEL);
 	if (!desc)
-		return;
+		return -ENOMEM;
 
 	desc->dev = kzalloc(sizeof(*desc->dev), GFP_KERNEL);
 	if (!desc->dev) {
 		kfree(desc);
-		return;
+		return -ENOMEM;
 	}
 
 	desc->dev->bus = &master->bus;
@@ -3744,23 +3744,36 @@ i3c_target_register_new_i3c_dev(struct i3c_master_controller *master, struct i3c
 	desc->dev->dev.release = i3c_target_device_release;
 	desc->info = info;
 	desc->common.master = master;
+	spin_lock_init(&desc->target_info.lock);
+	device_initialize(&desc->dev->dev);
 	dev_set_name(&desc->dev->dev, "%d-target", master->bus.id);
+	master->this = desc;
 
-	ret = device_register(&desc->dev->dev);
+	/* The target driver may start I/O as soon as device_add() probes it. */
+	ret = i3c_target_bus_init(master);
 	if (ret)
-		dev_err(&master->dev, "Failed to add I3C target device (err = %d)\n", ret);
+		goto err_put;
+	ret = device_add(&desc->dev->dev);
+	if (ret) {
+		i3c_target_bus_cleanup(master);
+		goto err_put;
+	}
+	return 0;
 
-	master->this = desc;
+err_put:
+	put_device(&desc->dev->dev);
+	master->this = NULL;
+	return ret;
 }
 
 static void i3c_target_unregister_i3c_dev(struct i3c_master_controller *master)
 {
 	struct i3c_dev_desc *i3cdev = master->this;
 
-	if (device_is_registered(&i3cdev->dev->dev))
-		device_unregister(&i3cdev->dev->dev);
-	else
-		put_device(&i3cdev->dev->dev);
+	device_del(&i3cdev->dev->dev);
+	i3c_target_bus_cleanup(master);
+	put_device(&i3cdev->dev->dev);
+	master->this = NULL;
 }
 
 static void i3c_target_read_device_info(struct device_node *np, struct i3c_device_info *info)
@@ -3834,7 +3847,7 @@ int i3c_target_register(struct i3c_master_controller *master, struct device *par
 			const struct i3c_target_ops *ops)
 {
 	struct i3c_bus *i3cbus = i3c_master_get_bus(master);
-	struct i3c_device_info info;
+	struct i3c_device_info info = {};
 	int ret;
 
 	ret = i3c_target_check_ops(ops);
@@ -3868,21 +3881,20 @@ int i3c_target_register(struct i3c_master_controller *master, struct device *par
 
 	ret = device_add(&master->dev);
 	if (ret)
-		goto err_put_device;
+		goto err_destroy_wq;
 
 	i3c_target_read_device_info(master->dev.of_node, &info);
 
-	i3c_target_register_new_i3c_dev(master, info);
-
-	ret = i3c_target_bus_init(master);
+	ret = i3c_target_register_new_i3c_dev(master, info);
 	if (ret)
-		goto err_cleanup_bus;
+		goto err_del_device;
 
 	return 0;
 
-err_cleanup_bus:
-	i3c_target_bus_cleanup(master);
-
+err_del_device:
+	device_del(&master->dev);
+err_destroy_wq:
+	destroy_workqueue(master->wq);
 err_put_device:
 	put_device(&master->dev);
 
@@ -3893,7 +3905,7 @@ EXPORT_SYMBOL_GPL(i3c_target_register);
 int i3c_target_unregister(struct i3c_master_controller *master)
 {
 	i3c_target_unregister_i3c_dev(master);
-	i3c_target_bus_cleanup(master);
+	destroy_workqueue(master->wq);
 	device_unregister(&master->dev);
 
 	return 0;
@@ -3902,12 +3914,57 @@ EXPORT_SYMBOL_GPL(i3c_target_unregister);
 
 int i3c_target_read_register(struct i3c_device *dev, const struct i3c_target_read_setup *setup)
 {
-	dev->desc->target_info.read_handler = setup->handler;
+	struct i3c_target_info *target = &dev->desc->target_info;
+	unsigned long flags;
+	int ret = 0;
 
-	return 0;
+	spin_lock_irqsave(&target->lock, flags);
+	if (target->read_handler)
+		ret = -EBUSY;
+	else
+		target->read_handler = setup->handler;
+	spin_unlock_irqrestore(&target->lock, flags);
+
+	return ret;
 }
 EXPORT_SYMBOL_GPL(i3c_target_read_register);
 
+void i3c_target_read_unregister(struct i3c_device *dev)
+{
+	struct i3c_target_info *target = &dev->desc->target_info;
+	unsigned long flags;
+
+	/* Also waits for an in-flight receive callback to finish. */
+	spin_lock_irqsave(&target->lock, flags);
+	target->read_handler = NULL;
+	spin_unlock_irqrestore(&target->lock, flags);
+}
+EXPORT_SYMBOL_GPL(i3c_target_read_unregister);
+
+void i3c_target_read_received(struct i3c_device *dev, const u8 *data, size_t len)
+{
+	struct i3c_target_info *target = &dev->desc->target_info;
+	unsigned long flags;
+
+	spin_lock_irqsave(&target->lock, flags);
+	if (target->read_handler)
+		target->read_handler(dev, data, len);
+	spin_unlock_irqrestore(&target->lock, flags);
+}
+EXPORT_SYMBOL_GPL(i3c_target_read_received);
+
+int i3c_target_get_info(struct i3c_device *dev, struct i3c_device_info *info)
+{
+	struct i3c_master_controller *master = i3c_dev_get_master(dev->desc);
+
+	if (!master->target || !master->target_ops->get_info)
+		return -EOPNOTSUPP;
+	*info = (struct i3c_device_info) {};
+	master->target_ops->get_info(dev->desc, info);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(i3c_target_get_info);
+
 int i3c_register(struct i3c_master_controller *master,
 		 struct device *parent,
 		 const struct i3c_master_controller_ops *master_ops,
