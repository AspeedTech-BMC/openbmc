@@ -1068,8 +1072,13 @@ static void ast2700_i3c_target_bus_cleanup(struct i3c_master_controller *m)
 	struct i3c_hci *hci = to_i3c_hci(m);
 
 	reg_clear(HC_CONTROL, HC_CONTROL_BUS_ENABLE);
+	reg_write(INTR_SIGNAL_ENABLE, 0);
+	disable_irq(hci->irq);
+	cancel_work_sync(&hci->halt_rst_work);
