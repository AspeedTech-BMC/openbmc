diff --git a/drivers/net/mctp/mctp-i3c-target.c b/drivers/net/mctp/mctp-i3c-target.c
new file mode 100644
index 000000000000..a4102d235421
--- /dev/null
+++ b/drivers/net/mctp/mctp-i3c-target.c
@@ -0,0 +1,295 @@
+// SPDX-License-Identifier: GPL-2.0
+/* MCTP over I3C, local target side (DMTF DSP0233). */
+
+#include <linux/crc8.h>
+#include <linux/i3c/device.h>
+#include <linux/i3c/master.h>
+#include <linux/module.h>
+#include <linux/netdevice.h>
+#include <linux/of.h>
+#include <linux/slab.h>
+#include <linux/workqueue.h>
+#include <net/mctp.h>
+#include <net/mctpdevice.h>
+#include <uapi/linux/if_arp.h>
+
+/* Baseline payload plus the four-byte MCTP transport header. */
+#define MCTP_I3C_TARGET_MTU	68
+#define MCTP_I3C_TARGET_MDB	0xae
+
+DECLARE_CRC8_TABLE(mctp_i3c_target_crc);
+
+struct mctp_i3c_target {
+	struct i3c_device *i3c;
+	struct net_device *ndev;
+	struct work_struct tx_work;
+	struct sk_buff_head tx_queue;
+	bool stopping;
+	/* Transfers may be DMA mapped, so do not put their buffers on stack. */
+	u8 *tx_buf;
+	/* MDB, optionally followed by its PEC byte. */
+	u8 *ibi_buf;
+	u8 ibi_len;
+};
+
+static u8 mctp_i3c_target_pec(u8 addr, const u8 *data, size_t len)
+{
+	u8 pec = crc8(mctp_i3c_target_crc, &addr, 1, 0);
+
+	return crc8(mctp_i3c_target_crc, data, len, pec);
+}
+
+static void mctp_i3c_target_rx(struct i3c_device *i3c, const u8 *data,
+			       size_t len)
+{
+	struct mctp_i3c_target *priv = i3cdev_get_drvdata(i3c);
+	struct net_device *ndev = priv->ndev;
+	struct i3c_device_info info;
+	struct sk_buff *skb;
+
+	if (READ_ONCE(priv->stopping))
+		return;
+	if (i3c_target_get_info(i3c, &info) || !info.dyn_addr)
+		goto drop;
+	if (len < sizeof(struct mctp_hdr) + 1 || len > info.max_write_len) {
+		ndev->stats.rx_length_errors++;
+		goto drop;
+	}
+	if (mctp_i3c_target_pec(info.dyn_addr << 1, data, len - 1) !=
+	    data[len - 1]) {
+		ndev->stats.rx_crc_errors++;
+		goto drop;
+	}
+
+	skb = netdev_alloc_skb(ndev, len - 1);
+	if (!skb)
+		goto drop;
+	skb_put_data(skb, data, len - 1);
+	skb->protocol = htons(ETH_P_MCTP);
+	skb_reset_mac_header(skb);
+	skb_reset_network_header(skb);
+	/* The sole physical next hop is the upstream I3C controller. */
+	__mctp_cb(skb)->halen = 0;
+	if (netif_rx(skb) == NET_RX_SUCCESS) {
+		ndev->stats.rx_packets++;
+		ndev->stats.rx_bytes += len - 1;
+	} else {
+		ndev->stats.rx_dropped++;
+	}
+	return;
+drop:
+	ndev->stats.rx_dropped++;
+}
+
+static const struct i3c_target_read_setup mctp_i3c_target_rx_setup = {
+	.handler = mctp_i3c_target_rx,
+};
+
+static void mctp_i3c_target_tx_work(struct work_struct *work)
+{
+	struct mctp_i3c_target *priv = container_of(work, typeof(*priv), tx_work);
+	struct net_device *ndev = priv->ndev;
+	struct i3c_device_info info;
+	struct i3c_priv_xfer data = {}, ibi = {};
+	struct sk_buff *skb;
+	int ret;
+
+	skb = skb_dequeue(&priv->tx_queue);
+	if (!skb)
+		return;
+	ret = i3c_target_get_info(priv->i3c, &info);
+	if (ret || !info.dyn_addr || READ_ONCE(priv->stopping))
+		goto drop;
+	if (!i3c_device_is_ibi_enabled(priv->i3c))
+		goto drop;
+	if (skb->len + 1 > info.max_read_len)
+		goto drop;
+	if (skb_copy_bits(skb, 0, priv->tx_buf, skb->len))
+		goto drop;
+	priv->tx_buf[skb->len] = mctp_i3c_target_pec((info.dyn_addr << 1) | 1,
+						     priv->tx_buf, skb->len);
+	data.data.out = priv->tx_buf;
+	data.len = skb->len + 1;
+	/* Controllers such as AST1060 and AST2600 require PEC after the MDB. */
+	if (priv->ibi_len > 1)
+		priv->ibi_buf[1] = mctp_i3c_target_pec((info.dyn_addr << 1) | 1,
+						       priv->ibi_buf, 1);
+	ibi.data.out = priv->ibi_buf;
+	ibi.len = priv->ibi_len;
+	ret = i3c_device_pending_read_notify(priv->i3c, &data, &ibi);
+	if (ret) {
+		ndev->stats.tx_errors++;
+		goto drop;
+	}
+	ndev->stats.tx_packets++;
+	ndev->stats.tx_bytes += skb->len;
+	goto done;
+drop:
+	ndev->stats.tx_dropped++;
+done:
+	dev_kfree_skb(skb);
+	if (!READ_ONCE(priv->stopping))
+		netif_wake_queue(ndev);
+}
+
+static netdev_tx_t mctp_i3c_target_xmit(struct sk_buff *skb,
+					struct net_device *ndev)
+{
+	struct mctp_i3c_target *priv = netdev_priv(ndev);
+
+	if (skb->len < sizeof(struct mctp_hdr) || skb->len > ndev->mtu) {
+		ndev->stats.tx_dropped++;
+		dev_kfree_skb(skb);
+		return NETDEV_TX_OK;
+	}
+	netif_stop_queue(ndev);
+	skb_queue_tail(&priv->tx_queue, skb);
+	schedule_work(&priv->tx_work);
+	return NETDEV_TX_OK;
+}
+
+static int mctp_i3c_target_open(struct net_device *ndev)
+{
+	struct mctp_i3c_target *priv = netdev_priv(ndev);
+	int ret;
+
+	WRITE_ONCE(priv->stopping, false);
+	ret = i3c_target_read_register(priv->i3c, &mctp_i3c_target_rx_setup);
+	if (ret) {
+		WRITE_ONCE(priv->stopping, true);
+		return ret;
+	}
+	netif_start_queue(ndev);
+	return 0;
+}
+
+static int mctp_i3c_target_stop(struct net_device *ndev)
+{
+	struct mctp_i3c_target *priv = netdev_priv(ndev);
+
+	WRITE_ONCE(priv->stopping, true);
+	netif_stop_queue(ndev);
+	i3c_target_read_unregister(priv->i3c);
+	cancel_work_sync(&priv->tx_work);
+	netif_stop_queue(ndev);
+	skb_queue_purge(&priv->tx_queue);
+	return 0;
+}
+
+static const struct net_device_ops mctp_i3c_target_netdev_ops = {
+	.ndo_open = mctp_i3c_target_open,
+	.ndo_stop = mctp_i3c_target_stop,
+	.ndo_start_xmit = mctp_i3c_target_xmit,
+};
+
+static void mctp_i3c_target_setup(struct net_device *ndev)
+{
+	ndev->type = ARPHRD_MCTP;
+	ndev->flags = IFF_POINTOPOINT | IFF_NOARP;
+	ndev->mtu = MCTP_I3C_TARGET_MTU;
+	ndev->min_mtu = MCTP_I3C_TARGET_MTU;
+	ndev->max_mtu = MCTP_I3C_TARGET_MTU;
+	ndev->tx_queue_len = 100;
+	ndev->netdev_ops = &mctp_i3c_target_netdev_ops;
+	/* No synthetic MAC header or neighbour entry is required. */
+	ndev->addr_len = 0;
+	ndev->hard_header_len = 0;
+}
+
+static int mctp_i3c_target_probe(struct i3c_device *i3c)
+{
+	struct device *dev = i3cdev_to_dev(i3c);
+	struct mctp_i3c_target *priv;
+	struct i3c_device_info info;
+	struct net_device *ndev;
+	char namebuf[IFNAMSIZ];
+	int ret;
+
+	if (!of_property_read_bool(dev->parent->of_node, "mctp-controller"))
+		return -ENODEV;
+	ret = i3c_target_get_info(i3c, &info);
+	if (ret)
+		return dev_err_probe(dev, ret, "Target lacks atomic device info\n");
+	if (info.max_write_len < MCTP_I3C_TARGET_MTU + 1 ||
+	    info.max_read_len < MCTP_I3C_TARGET_MTU + 1)
+		return dev_err_probe(dev, -EINVAL, "Target transfer limits below 69 bytes\n");
+	/* Name after the I3C bus, matching the controller-side mctp-i3c. */
+	snprintf(namebuf, sizeof(namebuf), "mctpi3ct%d", i3c->bus->id);
+	ndev = alloc_netdev(sizeof(*priv), namebuf, NET_NAME_ENUM,
+			    mctp_i3c_target_setup);
+	if (!ndev)
+		return -ENOMEM;
+	SET_NETDEV_DEV(ndev, dev);
+	priv = netdev_priv(ndev);
+	/* PIO accesses complete words, DMA needs a separately allocated buffer. */
+	priv->tx_buf = kzalloc(ALIGN(MCTP_I3C_TARGET_MTU + 1, 4), GFP_KERNEL);
+	if (!priv->tx_buf) {
+		free_netdev(ndev);
+		return -ENOMEM;
+	}
+	/* PIO loads the PEC byte after the MDB as a complete word. */
+	priv->ibi_buf = kzalloc(2 * sizeof(u32), GFP_KERNEL);
+	if (!priv->ibi_buf) {
+		kfree(priv->tx_buf);
+		free_netdev(ndev);
+		return -ENOMEM;
+	}
+	priv->i3c = i3c;
+	priv->ndev = ndev;
+	priv->stopping = true;
+	priv->ibi_buf[0] = MCTP_I3C_TARGET_MDB;
+	priv->ibi_len = of_property_read_bool(dev->parent->of_node,
+					      "ibi-append-pec") ? 2 : 1;
+	INIT_WORK(&priv->tx_work, mctp_i3c_target_tx_work);
+	skb_queue_head_init(&priv->tx_queue);
+	i3cdev_set_drvdata(i3c, priv);
+	ret = mctp_register_netdev(ndev, NULL, MCTP_PHYS_BINDING_I3C);
+	if (ret) {
+		i3cdev_set_drvdata(i3c, NULL);
+		kfree(priv->ibi_buf);
+		kfree(priv->tx_buf);
+		free_netdev(ndev);
+	}
+	return ret;
+}
+
+static void mctp_i3c_target_remove(struct i3c_device *i3c)
+{
+	struct mctp_i3c_target *priv = i3cdev_get_drvdata(i3c);
+
+	mctp_unregister_netdev(priv->ndev);
+	kfree(priv->ibi_buf);
+	kfree(priv->tx_buf);
+	free_netdev(priv->ndev);
+	i3cdev_set_drvdata(i3c, NULL);
+}
+
+static const struct i3c_device_id mctp_i3c_target_ids[] = {
+	I3C_CLASS(0xcc, NULL),
+	{},
+};
+MODULE_DEVICE_TABLE(i3c, mctp_i3c_target_ids);
+
+static struct i3c_driver mctp_i3c_target_driver = {
+	.driver.name = "mctp-i3c-target",
+	.id_table = mctp_i3c_target_ids,
+	.probe = mctp_i3c_target_probe,
+	.remove = mctp_i3c_target_remove,
+	.target = true,
+};
+
+static int __init mctp_i3c_target_init(void)
+{
+	crc8_populate_msb(mctp_i3c_target_crc, 0x07);
+	return i3c_driver_register(&mctp_i3c_target_driver);
+}
+module_init(mctp_i3c_target_init);
+
+static void __exit mctp_i3c_target_exit(void)
+{
+	i3c_driver_unregister(&mctp_i3c_target_driver);
+}
+module_exit(mctp_i3c_target_exit);
+
+MODULE_DESCRIPTION("MCTP I3C target network transport");
+MODULE_LICENSE("GPL");
