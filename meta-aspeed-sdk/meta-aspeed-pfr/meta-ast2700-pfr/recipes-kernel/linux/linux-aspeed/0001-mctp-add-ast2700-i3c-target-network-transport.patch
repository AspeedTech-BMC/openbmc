diff --git a/drivers/i3c/master.c b/drivers/i3c/master.c
index cd4d49c15dd6..9bbf3b8ba6bb 100644
--- a/drivers/i3c/master.c
+++ b/drivers/i3c/master.c
@@ -3720,7 +3720,7 @@ static void i3c_target_device_release(struct device *dev)
 	kfree(desc);
 }
 
-static void
