From 061f3aa12237feb5360617522bf82471adcb4209 Mon Sep 17 00:00:00 2001
From: Vince Chang <vince_chang@aspeedtech.com>
Date: Wed, 30 Apr 2025 15:52:36 +0800
Subject: [PATCH] bmcweb: firmware update apply immediate

Change update service defaults applyTime to immediate.
BMC will rebooting immediately after a firmware update via the WebUI.

Upstream-Status: Pending
Signed-off-by: Vince Chang <vince_chang@aspeedtech.com>
---
 redfish-core/lib/update_service.hpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/redfish-core/lib/update_service.hpp b/redfish-core/lib/update_service.hpp
index 0ac36b5f..a28895a2 100644
--- a/redfish-core/lib/update_service.hpp
+++ b/redfish-core/lib/update_service.hpp
@@ -987,7 +987,7 @@ inline void updateMultipartContext(
     }
     if (!multipart->applyTime)
     {
-        multipart->applyTime = "OnReset";
+        multipart->applyTime = "Immediate";
     }
 
     if constexpr (BMCWEB_REDFISH_UPDATESERVICE_USE_DBUS)
-- 
2.43.0

