From b0b56032901c0747ce7ec736d93111ffbf5fde8e Mon Sep 17 00:00:00 2001
From: VinceChang6637 <vince_chang@aspeedtech.com>
Date: Thu, 6 Jun 2024 17:35:26 +0800
Subject: [PATCH] Use aspeed's novnc fork

aspeed's novnc fork supports aspeed proprietary jpg.
Modify webpack's config for WebAssembly.

Upstream-Status: Inappropriate [ASPEED specific]
Signed-off-by: Jammy Huang <jammy_huang@aspeedtech.com>
Signed-off-by: VinceChang6637 <vince_chang@aspeedtech.com>
---
 package.json  | 6 +++++-
 vue.config.js | 8 ++++++++
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/package.json b/package.json
index 0ca43073..3c2a5815 100644
--- a/package.json
+++ b/package.json
@@ -4,6 +4,7 @@
     "private": true,
     "description": "OpenBMC Web UI using the Vue.js front-end framework",
     "scripts": {
+        "start": "react-scripts start --openssl-legacy-provider",
         "serve": "check-node-version --package && vue-cli-service serve --mode development",
         "build": "check-node-version --package && vue-cli-service build",
         "test:unit": "vue-cli-service test:unit",
@@ -16,7 +17,7 @@
     },
     "dependencies": {
         "@carbon/icons-vue": "10.49.1",
-        "@novnc/novnc": "1.3.0",
+        "@novnc/novnc": "git+https://github.com/AspeedTech-BMC/noVNC.git#346ec35",
         "@vue/compat": "3.4.29",
         "@vue/vue3-jest": "27.0.0",
         "@vuelidate/core": "2.0.3",
@@ -30,6 +31,8 @@
         "date-fns-tz": "1.3.6",
         "js-cookie": "3.0.1",
         "lodash": "4.17.21",
+        "react": "17.0.2",
+        "react-scripts": "5.0.1",
         "vue": "3.4.29",
         "vue-i18n": "10.0.5",
         "vue-loader": "17.4.2",
@@ -61,6 +64,7 @@
         "eslint-plugin-vue": "9.2.0",
         "eslint-scope": "7.1.1",
         "lint-staged": "13.0.3",
+        "path-browserify": "^1.0.1",
         "postcss-loader": "8.1.1",
         "prettier": "3.2.5",
         "sass": "1.75.0",
diff --git a/vue.config.js b/vue.config.js
index e33918e4..0467ff52 100644
--- a/vue.config.js
+++ b/vue.config.js
@@ -92,6 +92,10 @@ module.exports = {
           `@/env/components/AppNavigation/${envName}.js`;
       }
     }
+    config.resolve.fallback = {
+      fs: false,
+      path: require.resolve('path-browserify'),
+    };
 
     if (process.env.NODE_ENV === 'production') {
       config.plugins.push(
@@ -101,6 +105,10 @@ module.exports = {
       );
     }
 
+    config.experiments = {
+      asyncWebAssembly: true,
+    };
+
     config.performance = {
       hints: 'warning',
       maxEntrypointSize: 512000,
-- 
2.43.0

