From a09adbfda00ce252db54e67c18823a4c5a52a7e1 Mon Sep 17 00:00:00 2001
From: Vince Chang <vince_chang@aspeedtech.com>
Date: Tue, 17 Mar 2026 11:10:45 -0600
Subject: [PATCH] Use aspeed's novnc fork

aspeed's novnc fork supports aspeed proprietary jpg.
Modify webpack's config for WebAssembly.

Upstream-Status: Inappropriate [ASPEED specific]
Signed-off-by: Jammy Huang <jammy_huang@aspeedtech.com>
Signed-off-by: Vince Chang <vince_chang@aspeedtech.com>
---
 package.json  | 3 ++-
 vue.config.js | 8 ++++++++
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/package.json b/package.json
index 5a649b9..8d70f01 100644
--- a/package.json
+++ b/package.json
@@ -21,7 +21,7 @@
     },
     "dependencies": {
         "@carbon/icons-vue": "10.49.1",
-        "@novnc/novnc": "1.3.0",
+        "@novnc/novnc": "git+https://github.com/AspeedTech-BMC/noVNC.git#346ec35",
         "@tanstack/vue-query": "5.92.9",
         "@vue/vue3-jest": "27.0.0",
         "@vuelidate/core": "2.0.3",
@@ -65,6 +65,7 @@
         "happy-dom": "18.0.1",
         "jsdom": "26.1.0",
         "lint-staged": "16.0.0",
+        "path-browserify": "^1.0.1",
         "prettier": "3.4.2",
         "sass": "1.97.2",
         "simple-git-hooks": "2.13.1",
diff --git a/vue.config.js b/vue.config.js
index d220cad..1dfcc49 100644
--- a/vue.config.js
+++ b/vue.config.js
@@ -131,6 +131,10 @@ module.exports = {
           `@/env/components/AppNavigation/${envName}.js`;
       }
     }
+    config.resolve.fallback = {
+      fs: false,
+      path: require.resolve('path-browserify'),
+    };
 
     if (process.env.NODE_ENV === 'production') {
       config.plugins.push(
@@ -140,6 +144,10 @@ module.exports = {
       );
     }
 
+    config.experiments = {
+      asyncWebAssembly: true,
+    };
+
     config.performance = {
       hints: 'warning',
       maxEntrypointSize: 512000,
-- 
2.43.0

