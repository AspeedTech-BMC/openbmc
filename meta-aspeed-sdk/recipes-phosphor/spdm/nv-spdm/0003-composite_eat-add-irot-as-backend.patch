+# SPDX-License-Identifier: Apache-2.0
+#
+# MockAttester subproject — software-only PlatformAttester backend.
+#
+# Compiled only when meson option attester-backend=mock is selected.
+# Produces a static library with the composite EAT/COSE_Sign1 builder and
+# the MockAttester implementation. Depends on the vendor-neutral composite
+# core for the deterministic CBOR writer and shared types.
+#
+irot_attester_sources = files(
+    'platform_transport_irot.cpp',
+    'rot_platform_attester.cpp',
+    'generation_request.c',
+    'token_builder.c',
+    'types.c',
+    'qcbor/src/ieee754.c',
+    'qcbor/src/qcbor_decode.c', 
+    'qcbor/src/qcbor_encode.c', 
+    'qcbor/src/qcbor_err_to_str.c',
+    'qcbor/src/UsefulBuf.c'
+)
+
+irot_attester_inc = include_directories('.', '..', 'qcbor/inc', 'qcbor/inc/qcbor')
+
+threads_dep = dependency('threads')
+
+irot_attester_lib = static_library(
+    'irot_attester',
+    irot_attester_sources,
+    implicit_include_directories: false,
+    include_directories: irot_attester_inc,
+    dependencies: [
+        crypto_deps,    # mbedcrypto + mbedx509
+        composite_dep,  # cbor_det + composite types
+        threads_dep,
+    ],
+    cpp_args: ['-DATTESTER_BACKEND_IROT'],
+)
+
+irot_attester_dep = declare_dependency(
+    include_directories: irot_attester_inc,
+    link_with: irot_attester_lib,
+    dependencies: [crypto_deps, composite_dep, threads_dep],
+    compile_args: ['-DATTESTER_BACKEND_IROT'],
+)
diff --git a/spdmd/irot_attester/platform_transport_irot.cpp b/spdmd/irot_attester/platform_transport_irot.cpp
new file mode 100644
index 0000000..3af2a22
--- /dev/null
+++ b/spdmd/irot_attester/platform_transport_irot.cpp
@@ -0,0 +1,164 @@
+// SPDX-License-Identifier: Apache-2.0
+
+#include "platform_transport_irot.hpp"
+
+#include <linux/mctp.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+#include <vector>
+
+namespace bmc::composite {
+namespace {
+
+/*
+ * MCTP Vendor Defined - PCI (DSP0239) message type. Assumes in-kernel MCTP
+ * (AF_MCTP sockets), matching spdmcpp::MctpIoClass's MCTP_IN_KERNEL path. If
+ * this platform instead routes through mctp-demux-daemon, this needs the
+ * AF_UNIX/SOCK_SEQPACKET handshake that class uses in its non-kernel branch.
+ */
+constexpr std::uint8_t kMctpTypeVendorDefinedPci = 0x7e;
+constexpr std::uint16_t kPciVendorId = 0x1a03;
+constexpr std::uint8_t kTargetEid = 10;
+constexpr timeval kResponseTimeout{/*tv_sec=*/1, /*tv_usec=*/0};
+
+/* Releases readySem on every exit path, including early returns. */
+class SemaphoreGuard {
+  public:
+    explicit SemaphoreGuard(sem_t& sem) :
+        sem_(sem), acquired_(sem_wait(&sem_) == 0)
+    {}
+
+    ~SemaphoreGuard()
+    {
+        if (acquired_)
+        {
+            sem_post(&sem_);
+        }
+    }
+
+    SemaphoreGuard(const SemaphoreGuard&) = delete;
+    SemaphoreGuard& operator=(const SemaphoreGuard&) = delete;
+
+    bool acquired() const
+    {
+        return acquired_;
+    }
+
+  private:
+    sem_t& sem_;
+    bool acquired_;
+};
+
+} // namespace
+
+PlatformTransport::PlatformTransport()
+{
+    sem_init(&readySem, /*pshared=*/0, /*value=*/1);
+}
+
+PlatformTransport::~PlatformTransport()
+{
+    sem_destroy(&readySem);
+}
+
+TransportResult PlatformTransport::submit(std::span<const std::uint8_t> request,
+                                          std::size_t responseCapacity) {
+	TransportResult result;
+
+	SemaphoreGuard guard(readySem);
+	if (!guard.acquired())
+	{
+		result.errorMessage = "failed to acquire platform transport semaphore";
+		return result;
+	}
+
+	const int sock = socket(AF_MCTP, SOCK_DGRAM, 0);
+	if (sock < 0)
+	{
+		result.errorMessage = "failed to open MCTP socket";
+		return result;
+	}
+
+	setsockopt(sock, SOL_SOCKET, SO_RCVTIMEO, &kResponseTimeout,
+	          sizeof(kResponseTimeout));
+
+	sockaddr_mctp txAddr{};
+	txAddr.smctp_family = AF_MCTP;
+	txAddr.smctp_network = MCTP_NET_ANY;
+	txAddr.smctp_addr.s_addr = kTargetEid;
+	txAddr.smctp_type = kMctpTypeVendorDefinedPci;
+	txAddr.smctp_tag = MCTP_TAG_OWNER;
+
+	// Vendor Defined - PCI body: 2-byte big-endian PCI Vendor ID followed by
+	// the vendor-defined payload. The message-type byte itself is not part
+	// of this buffer; the kernel supplies it from smctp_type.
+	std::vector<std::uint8_t> payload;
+	payload.reserve(2 + request.size());
+	payload.push_back(static_cast<std::uint8_t>(kPciVendorId >> 8));
+	payload.push_back(static_cast<std::uint8_t>(kPciVendorId & 0xff));
+	payload.insert(payload.end(), request.begin(), request.end());
+
+	const ssize_t sent = sendto(sock, payload.data(), payload.size(), 0,
+	                            reinterpret_cast<const sockaddr*>(&txAddr),
+	                            sizeof(txAddr));
+	if (sent < 0 || static_cast<std::size_t>(sent) != payload.size())
+	{
+		result.errorMessage = "failed to send MCTP vendor-defined PCI request";
+		close(sock);
+		return result;
+	}
+
+	std::vector<std::uint8_t> rxBuf(2 + responseCapacity);
+	sockaddr_mctp rxAddr{};
+	socklen_t rxAddrLen = sizeof(rxAddr);
+	const ssize_t received =
+	    recvfrom(sock, rxBuf.data(), rxBuf.size(), MSG_TRUNC,
+	            reinterpret_cast<sockaddr*>(&rxAddr), &rxAddrLen);
+	close(sock);
+
+	if (received < 0)
+	{
+		result.errorMessage = "failed to receive MCTP vendor-defined PCI response";
+		return result;
+	}
+	if (static_cast<std::size_t>(received) > rxBuf.size())
+	{
+		result.errorMessage = "MCTP vendor-defined PCI response truncated";
+		return result;
+	}
+	if (rxAddr.smctp_addr.s_addr != kTargetEid ||
+	    rxAddr.smctp_type != kMctpTypeVendorDefinedPci)
+	{
+		result.errorMessage = "MCTP vendor-defined PCI response from unexpected source";
+		return result;
+	}
+	if (received < 2)
+	{
+		result.errorMessage = "MCTP vendor-defined PCI response too short";
+		return result;
+	}
+
+	const std::uint16_t responseVendorId =
+	    (static_cast<std::uint16_t>(rxBuf[0]) << 8) | rxBuf[1];
+	if (responseVendorId != kPciVendorId)
+	{
+		result.errorMessage = "unexpected PCI vendor ID in MCTP response";
+		return result;
+	}
+
+	result.response.assign(rxBuf.begin() + 2, rxBuf.begin() + received);
+	result.success = true;
+	return result;
+}
+
+bool PlatformTransport::isReady() const {
+	int value = 0;
+	if (sem_getvalue(const_cast<sem_t*>(&readySem), &value) != 0)
+	{
+		return false;
+	}
+	return value > 0;
+}
+
+} // namespace bmc::composite
diff --git a/spdmd/irot_attester/platform_transport_irot.hpp b/spdmd/irot_attester/platform_transport_irot.hpp
new file mode 100644
index 0000000..3ed2247
--- /dev/null
+++ b/spdmd/irot_attester/platform_transport_irot.hpp
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: Apache-2.0
+
+#include "composite_eat_transport.hpp"
+
+#include <semaphore.h>
+
+namespace bmc::composite {
+
+/*
+ * readySem is a binary semaphore (initial value 1) guarding the platform
+ * command channel. isReady() peeks at it without blocking; submit() holds
+ * it for the duration of the transfer, so isReady() reports busy for
+ * exactly as long as a transfer is in flight.
+ */
+class PlatformTransport final : public CompositeEatTransport {
+  public:
+    PlatformTransport();
+    ~PlatformTransport() override;
+
+    PlatformTransport(const PlatformTransport&) = delete;
+    PlatformTransport& operator=(const PlatformTransport&) = delete;
+    PlatformTransport(PlatformTransport&&) = delete;
+    PlatformTransport& operator=(PlatformTransport&&) = delete;
+
+    TransportResult submit(std::span<const std::uint8_t> request,
+                           std::size_t responseCapacity) override;
+
+    bool isReady() const override;
+
+  private:
+    sem_t readySem;
+};
+
+} // namespace bmc::composite
