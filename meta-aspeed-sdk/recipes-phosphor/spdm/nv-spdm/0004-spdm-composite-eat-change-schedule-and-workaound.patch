     if (bindingType.empty())
     {
         auto& log = spdmApp.getLog();
@@ -633,7 +634,6 @@ void MctpDiscovery::mctpNewObjectSignal(const sdbusplus::object_path& objPath,
             log.iprintln(eidValue1);
         }
 
-	bindingType = "xyz.openbmc_project.MCTP.Binding.Types.SPI";
         // return;
     }
