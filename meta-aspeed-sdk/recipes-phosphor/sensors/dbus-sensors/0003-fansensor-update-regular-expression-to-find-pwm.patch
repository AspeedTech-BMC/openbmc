From b1d5b2aa3965759aeee7edbe403e24e87d4d46bc Mon Sep 17 00:00:00 2001
From: Vince Chang <vince_chang@aspeedtech.com>
Date: Tue, 12 Dec 2023 18:22:39 +0800
Subject: [PATCH 3/3] fansensor update regular expression to find pwm

Update the regular expression to only find pwm* while excluding
pwm*_enable.

Upstream-Status: Pending
Signed-off-by: Vince Chang <vince_chang@aspeedtech.com>
---
 src/fan/FanMain.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/fan/FanMain.cpp b/src/fan/FanMain.cpp
index 95f5d27..2810eba 100644
--- a/src/fan/FanMain.cpp
+++ b/src/fan/FanMain.cpp
@@ -147,7 +147,7 @@ bool findPwmfanPath(unsigned int configPwmfanIndex,
 
     pwnfanDevName += std::to_string(configPwmfanIndex);
 
-    if (!findFiles(std::filesystem::path("/sys/class/hwmon"), R"(pwm\d+)",
+    if (!findFiles(std::filesystem::path("/sys/class/hwmon"), R"(pwm\d+$)",
                    pwmfanPaths))
     {
         lg2::error("No PWMs are found!");
